{
  "name": "dynasty-tree",
  "version": "0.4.0",
  "description": "Obsidian plugin: editable family trees for fictional dynasties",
  "scripts": {
    "test": "vitest run --project fast",
    "test:perf": "vitest run --project perf",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "format-doc": "tsx scripts/format/generate.ts",
    "build": "node esbuild.config.mjs production",
    "size": "node scripts/size.mjs",
    "version-bump": "node scripts/version-bump.mjs",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint src scripts tests"
  },
  "author": "James Babikian",
  "license": "GPL-3.0-only",
  "type": "module",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "lightningcss": "1.33.0",
    "obsidian": "^1.13.1",
    "postcss": "8.5.31",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "private": true
}
